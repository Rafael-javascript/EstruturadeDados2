#include <iostream>
#include <string>
#include <stdio.h>

using namespace std;

struct Aluno {
    string nome;
    int idade;
    float nota1;
    float nota2;
    float nota3;
    float media;

    void insere(string stnome, int stidade, float n1, float n2, float n3) {
        nome = stnome;
        idade = stidade;
        nota1 = n1;
        nota2 = n2;
        nota3 = n3;
        media = (n1 + n2 + n3) / 3.0f;
    }

    void mostra() {
        cout << nome << "\t" << media << "\t";
        if (media >= 7.0) {
            cout << "Aprovado\n";
        } else {
            cout << "Reprovado\n";
        }
    }
};

int main() {
    Aluno alunos[5];

    alunos[0].insere("Rafael Santos Nascimento", 21, 8.0, 7.5, 7.0);
    alunos[1].insere("Eduardo Mauricio Pereira", 19, 6.0, 6.0, 5.0);
    alunos[2].insere("Vitoria da Silva Castro", 25, 4.0, 6.0, 5.0);
    alunos[3].insere("Isabela de Souza Oliveira", 18, 10.0, 8.5, 9.0);
    alunos[4].insere("Jose Machado Costa", 28, 9.0, 7.0, 6.5);

    int aprovados = 0;
    int reprovados = 0;
    int posMaior = 0;

    cout << "Nome\t\t\t\tMedia\tSituacao\n";
    printf("\n");

    for (int i = 0; i < 5; i++) {
        alunos[i].mostra();

        if (alunos[i].media >= 7.0) {
            aprovados++;
        } else {
            reprovados++;
        }

        if (alunos[i].media > alunos[posMaior].media) {
            posMaior = i;
        }
    }

    printf("\n");
    cout << "Quantidade de Aprovados: " << aprovados << "\n";
    cout << "Quantidade de Reprovados: " << reprovados << "\n";
    cout << "Aluno com maior media: " << alunos[posMaior].nome << " (" << alunos[posMaior].media << ")\n";

    return 0;
}
