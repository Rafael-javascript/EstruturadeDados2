#include <iostream>
#include <stdio.h>
#include <struct>

using namespace std;

int main() {
    float notas[4][3];
    float media;

    notas[0][0] = 8.0; notas[0][1] = 7.5; notas[0][2] = 6.0;
    notas[1][0] = 9.0; notas[1][1] = 8.5; notas[1][2] = 10.0;
    notas[2][0] = 5.0; notas[2][1] = 4.0; notas[2][2] = 6.5;
    notas[3][0] = 7.0; notas[3][1] = 8.0; notas[3][2] = 9.0;

    cout << "         P1   P2   P3   Media\n";

    for (int i = 0; i < 4; i++) {
        cout << "Aluno " << i + 1 << "  ";
        
        float soma = 0;
        for (int j = 0; j < 3; j++) {
            cout << notas[i][j] << "  ";
            soma += notas[i][j];
        }

        media = soma / 3.0f;
        cout << "| " << media << "\n";
    }

    return 0;
}
