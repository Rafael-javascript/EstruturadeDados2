#include <iostream>
#include <stdio.h>

using namespace std;

int main() {
    int matriz[4][4];
    int soma = 0;

    for (int i = 0; i < 4; i++) {
        for (int j = 0; j < 4; j++) {
            cin >> matriz[i][j];
        }
    }

    cout << "\nDiagonal principal:\n";
    for (int i = 0; i < 4; i++) {
        cout << matriz[i][i] << " ";
        soma += matriz[i][i];
    }

    cout << "\n\nSoma:\n" << soma << "\n";

    return 0;
}
